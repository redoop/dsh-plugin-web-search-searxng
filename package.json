{
  "name": "dsh-plugin-web-search-searxng",
  "version": "0.1.0",
  "description": "DSH web plugin: register a local/remote SearXNG instance as the ctx.web search provider (replaces cloud search backends)",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "searxng",
    "web-search",
    "metasearch"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
